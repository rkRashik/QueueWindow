DATABASE_URL= # Neon PostgreSQL connection string with SSL enabled.
JWT_SECRET= # Random session signing key, at least 32 bytes.
APP_URL= # Optional locally. Set to the public HTTPS origin for hosted deployments.
# Tests (put these in .env.test.local). Both must be loopback Postgres databases.
QW_TEST_DATABASE_URL= # Vitest integration suite; each run uses a throwaway schema.
QW_E2E_DATABASE_URL= # Playwright; the app server is started against this database.
QW_TRIAL_DAYS= # Optional. Empty = free workspaces that never expire; 14 = new signups get a 14-day trial.
