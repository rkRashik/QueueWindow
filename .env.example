# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Optional locally; REQUIRED on Vercel. Never use file: storage on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# scrypt hash produced by npm run password (see README). Demo does not need it.
STAFF_PASSWORD_HASH=
# Exact public origin, no trailing slash. Optional for local development.
APP_URL=
