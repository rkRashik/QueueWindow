# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Optional locally; REQUIRED on Vercel. Never use file: storage on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required for staff sign-in. Generate the scrypt hash with npm run password.
STAFF_PASSWORD_HASH=
# Exact public origin, no trailing slash. Optional for local development.
APP_URL=
